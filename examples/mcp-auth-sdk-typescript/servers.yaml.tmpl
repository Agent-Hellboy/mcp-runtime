servers:
  - name: mcp-auth-sdk-typescript
    description: TypeScript MCP resource server protected by the mcp-auth TypeScript client SDK.
    image: registry.mcpruntime.org/mcp-auth-sdk-typescript
    imageTag: __IMAGE_TAG__
    scope: public
    port: 8081
    publicPathPrefix: mcp-auth-sdk-typescript
    envVars:
      - name: MCP_PORT
        value: "8081"
      - name: MCP_AUTH_ISSUER
        value: https://auth.mcpruntime.org/mcp-auth
      - name: MCP_AUTH_JWKS_URI
        value: https://auth.mcpruntime.org/mcp-auth/.well-known/jwks.json
      - name: MCP_RESOURCE
        value: https://mcp.mcpruntime.org/mcp-auth-sdk-typescript/mcp
    auth:
      mode: oauth
      tokenHeader: Authorization
      issuerURL: https://auth.mcpruntime.org/mcp-auth
      audience: https://mcp.mcpruntime.org/mcp-auth-sdk-typescript/mcp
    gateway:
      enabled: false
    tools:
      - name: whoami
        description: Return the subject and scopes from the verified access token.
        requiredTrust: low
        sideEffect: read
        riskLevel: low
